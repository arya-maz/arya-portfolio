---
import Layout from '../layouts/Layout.astro';
import LinkedInFeed from '../components/LinkedInFeed.astro';
const name = 'Arya Mazandarani';
let letterIndex = 0;
const nameWords = name.split(' ').map(word => Array.from(word, letter => ({ letter, index: letterIndex++ })));
---
<Layout title="Home" page="Home">
  <h1 class="home-heading">
    <span class="sr-only">{name}</span>
    <span class="name-field" aria-hidden="true">
      {nameWords.map((word, wordIndex) => <>
        <span class="name-word">{word.map(({ letter, index }) =>
          <span
            class="name-letter"
            data-first={index === 0 ? '' : undefined}
            data-last={index === letterIndex - 1 ? '' : undefined}
            style={`--letter-index:${index}`}
          >{letter}</span>
        )}</span>{wordIndex < nameWords.length - 1 ? ' ' : ''}
      </>)}
    </span>
  </h1>
  <section class="bio" aria-label="Introduction">
    <p>I'm a recent Computer Science graduate from NJIT -- creating ambitious, scalable, and practical projects for real people to use and benefit from. Some of my projects can be viewed <a href="/projects">here</a>.</p>
    <p>Currently <strong><mark>seeking a full-time position</mark></strong> that would apply my ambition and expertise into building reliable and effective systems to help people solve meaningful problems.</p>
    <p>When I'm not building tech projects, you can find me working out, going on adventurous walks, or playing guitar. Click <a href="/hobbies">here</a> to explore my hobbies and interests further!</p>
    <p>Learn more about me and my journey by using the tabs above to navigate to other pages and get to know me a little better</p>
  </section>
  <LinkedInFeed />
</Layout>

<style>
  .bio {
    display: grid;
    gap: clamp(18px, 3vw, 30px);
    max-width: 64ch;
    margin-inline: auto;
    text-align: center;
    font-size: clamp(1.2rem, 1.9vw, 1.55rem);
  }

  .bio p { text-wrap: pretty; }

  .bio a {
    color: var(--accent-bright);
    text-decoration: underline;
    text-underline-offset: .2em;
  }

  mark {
    color: var(--accent-bright);
    font-weight: 700;
    background: linear-gradient(transparent 70%, rgb(156 188 224 / 26%) 70%) left / 100% 100% no-repeat;
  }

  .home-heading { text-align: center; }

  .name-field {
    display: inline-block;
    max-width: 100%;
    padding: clamp(12px, 2vw, 24px) clamp(10px, 3.5vw, 44px);
    border: 1px solid var(--line-bright);
    border-radius: var(--radius-control);
    background: var(--surface-deep);
    box-shadow: inset 0 2px 7px rgb(0 0 0 / 26%);
  }

  .name-word { white-space: nowrap; }

  @media (prefers-reduced-motion: no-preference) {
    :global(html:not([data-folder-direction])) .name-letter {
      --caret-cycle: 420ms;
      --type-start: calc(2 * var(--caret-cycle));
      --type-interval: 52ms;
      --type-delay: calc(var(--type-start) + var(--letter-index) * var(--type-interval));
      position: relative;
      animation: type-letter 1ms step-end var(--type-delay) backwards;
    }

    :global(html:not([data-folder-direction])) .name-letter::after,
    :global(html:not([data-folder-direction])) .name-letter[data-first]::before {
      position: absolute;
      top: .18em;
      bottom: .16em;
      width: 2px;
      background: var(--accent-bright);
      content: '';
      opacity: 0;
    }

    :global(html:not([data-folder-direction])) .name-letter[data-first]::before {
      left: 0;
      animation: blink-caret var(--caret-cycle) step-end 2;
    }

    :global(html:not([data-folder-direction])) .name-letter::after {
      right: -.045em;
      animation: type-caret var(--type-interval) step-end var(--type-delay);
    }

    :global(html:not([data-folder-direction])) .name-letter[data-last]::after {
      animation: blink-caret 520ms step-end var(--type-delay) 3;
    }

    :global(html:not([data-folder-direction])) mark {
      animation: underline 300ms var(--ease-out) 42ms both;
    }
  }

  @keyframes type-letter { from { color: transparent; } }
  @keyframes type-caret { from { opacity: 1; } }
  @keyframes blink-caret { 0% { opacity: 1; } 55% { opacity: 0; } }
  @keyframes underline { from { background-size: 0 100%; } }
</style>
