---
interface Props { title: string; subtitle: string }
const { title, subtitle } = Astro.props;
---
<div class="page-heading">
  {Astro.slots.has('aside') ? <div class="heading-title-row"><h1>{title}</h1><slot name="aside" /></div> : <h1>{title}</h1>}
  <p>{subtitle}</p>
</div>
<style>
  .heading-title-row { display: flex; align-items: center; justify-content: space-between; gap: var(--space-4); }
</style>
