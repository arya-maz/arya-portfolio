---
import { socials } from '../data/social';

interface Props {
  posts?: ReadonlyArray<{ url: string; publishedAt: string; excerpt: string }>;
}
const { posts = [] } = Astro.props;
const profileUrl = socials.find(social => social.name === 'LinkedIn')?.href;
const dateFormat = new Intl.DateTimeFormat('en-US', { dateStyle: 'medium', timeZone: 'UTC' });
---
<section class="feed" aria-labelledby="feed-heading">
  <div class="feed-heading">
    <h2 id="feed-heading">Feed</h2>
    {profileUrl && <a href={profileUrl} target="_blank" rel="noopener noreferrer">LinkedIn ↗</a>}
  </div>
  {posts.length === 0 ? <p class="feed-empty">Recent LinkedIn posts will appear here.</p> : (
    <ol class="feed-posts">
      {posts.map(post => <li>
        <article>
          <time datetime={post.publishedAt}>{dateFormat.format(new Date(post.publishedAt))}</time>
          <p>{post.excerpt}</p>
          <a href={post.url} target="_blank" rel="noopener noreferrer">View post on LinkedIn ↗</a>
        </article>
      </li>)}
    </ol>
  )}
</section>

<style>
  .feed {
    margin-top: clamp(36px, 6vw, 72px);
    padding-top: var(--section-gap);
    border-top: 1px solid var(--line);
  }

  .feed-heading {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--space-3);
  }

  .feed a {
    color: var(--accent-bright);
    text-underline-offset: .2em;
  }

  .feed a:hover { text-decoration: underline; }
  .feed-empty { margin-top: var(--space-3); }

  .feed-posts {
    display: grid;
    gap: var(--space-3);
    margin-top: var(--space-4);
    padding: 0;
    list-style: none;
  }

  article {
    display: grid;
    gap: var(--space-2);
    padding: var(--space-4);
    border: 1px solid var(--line);
    border-radius: var(--radius-surface);
    background: var(--surface);
  }

  time, .feed-empty { color: var(--text-muted); }
  time { font-size: var(--size-small); }
</style>
