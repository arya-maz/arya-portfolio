---
import { linkedinPosts } from '../data/linkedin';
import { publicYouTubeVideos } from '../data/youtube';

const posts = [
  ...linkedinPosts.map(post => ({ ...post, platform: 'linkedin' as const })),
  ...publicYouTubeVideos.map(video => ({ ...video, platform: 'youtube' as const })),
].sort((a, b) => b.publishedAt.localeCompare(a.publishedAt)).slice(0, 10);
const dateFormat = new Intl.DateTimeFormat('en-US', { dateStyle: 'long', timeZone: 'UTC' });
---
<section class="feed" aria-labelledby="feed-heading">
  <h2 id="feed-heading" class="feed-heading">Feed</h2>
  {posts.length === 0 ? <p class="feed-empty">No public posts have been added yet.</p> : (
    <ol class="feed-posts">
      {posts.map(post => <li>
        {post.platform === 'youtube' ? <>
          <p class="post-caption">Uploaded a video to YouTube on <time datetime={post.publishedAt}>{dateFormat.format(new Date(post.publishedAt))}</time>:</p>
          <iframe
            class="post-embed youtube-embed"
            src={`https://www.youtube-nocookie.com/embed/${post.id}?playsinline=1`}
            title={post.title}
            loading="lazy"
            allow="encrypted-media; fullscreen; picture-in-picture"
            referrerpolicy="strict-origin-when-cross-origin"
            allowfullscreen
          ></iframe>
        </> : post.embed ? <>
          <p class="post-caption">Posted on LinkedIn on <time datetime={post.publishedAt}>{dateFormat.format(new Date(post.publishedAt))}</time>:</p>
          <iframe
            class="post-embed"
            src={post.embed.src}
            title={`LinkedIn post from ${dateFormat.format(new Date(post.publishedAt))}`}
            width="504"
            height={post.embed.height ?? 480}
            loading="lazy"
            referrerpolicy="strict-origin-when-cross-origin"
            allowfullscreen
          ></iframe>
        </> : <article>
          <time datetime={post.publishedAt}>{dateFormat.format(new Date(post.publishedAt))}</time>
          <p class="post-text">{post.text}</p>
          {post.image && <img class="post-image" src={post.image.src} alt={post.image.alt} loading="lazy" />}
        </article>}
        <a
          class="project-link feed-post-link"
          href={post.platform === 'youtube' ? `https://www.youtube.com/watch?v=${post.id}` : post.url}
          target="_blank"
          rel="noopener noreferrer"
        >View in {post.platform === 'youtube' ? 'YouTube' : 'LinkedIn'} ↗</a>
      </li>)}
    </ol>
  )}
</section>

<style>
  .feed {
    margin-top: clamp(36px, 6vw, 72px);
    padding-top: var(--section-gap);
    border-top: 1px solid var(--line);
  }

  .feed-heading, .feed-posts, .feed-empty {
    max-width: 48rem;
    margin-inline: auto;
  }

  .feed-heading {
    font-size: calc(var(--size-h1) * .94);
    font-weight: 690;
    line-height: 1.06;
    letter-spacing: -.055em;
  }

  .feed-post-link {
    display: inline-block;
    margin-top: var(--space-2);
    font-size: var(--size-small);
  }

  .feed-empty { margin-top: var(--space-3); }

  .feed-posts {
    --post-spacing: clamp(34px, 5vw, 60px);
    display: grid;
    gap: var(--post-spacing);
    grid-template-columns: minmax(0, 1fr);
    margin-top: var(--space-4);
    padding: 0;
    list-style: none;
  }

  .feed-posts > li + li {
    padding-top: var(--post-spacing);
    border-top: 1px solid var(--line-soft);
  }

  article {
    display: grid;
    gap: var(--space-2);
    padding: var(--space-4);
    border: 1px solid var(--line);
    border-radius: var(--radius-surface);
    background: var(--surface);
  }

  .post-text { white-space: pre-wrap; overflow-wrap: anywhere; }

  .post-image {
    max-width: 100%;
    height: auto;
    border-radius: var(--radius-control);
  }

  .post-caption {
    margin-bottom: var(--space-3);
    font-size: clamp(1.125rem, 2vw, 1.375rem);
    font-weight: 600;
    line-height: 1.4;
  }
  .post-caption time { font-size: inherit; }

  .post-embed {
    display: block;
    width: 100%;
    max-width: 100%;
    border: 0;
    border-radius: var(--radius-control);
    background: var(--surface-deep);
  }

  .youtube-embed { aspect-ratio: 16 / 9; min-height: 200px; }

  time, .feed-empty { color: var(--text-muted); }
  time { font-size: var(--size-small); }
</style>
