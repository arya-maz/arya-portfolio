---
export const pages = ['Home', 'Projects', 'Experience', 'Hobbies', 'Connect'] as const;
interface Props { active: typeof pages[number] }
const { active } = Astro.props;
const links = pages.map((name, index) => ({
  name,
  index,
  href: name === 'Home' ? '/' : `/${name.toLowerCase()}`,
}));
---
<header class="site-header" transition:persist="workspace-navigation">
  <a class="wordmark" href="/" aria-label="Arya Mazandarani — Home">am</a>
  <nav class="desktop-nav" aria-label="Main navigation">
    {links.map(({name, index, href}) => <a href={href} class="nav-tab" data-folder-tab={index} style={`--tab-index:${index}`} aria-current={active === name ? 'page' : undefined}>
      <span>{name}</span>
    </a>)}
  </nav>
  <button type="button" class="menu-toggle" aria-label="Open navigation" aria-expanded="false" aria-controls="mobile-navigation" hidden>
    <img src="/design/23-231.svg" width="18" height="14" alt="" />
  </button>
  <nav id="mobile-navigation" class="mobile-nav" aria-label="Mobile navigation" hidden>
    {links.map(({name, index, href}) => <a href={href} data-folder-tab={index} aria-current={active === name ? 'page' : undefined}>{name}</a>)}
  </nav>
</header>
