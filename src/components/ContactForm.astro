---
const candidate = import.meta.env.PUBLIC_FORMSPREE_ENDPOINT?.trim() || '';
const endpoint = /^https:\/\/formspree\.io\/f\/[a-zA-Z0-9]+$/.test(candidate) ? candidate : '';
---
<section class="contact-box" aria-labelledby="contact-heading">
  <h2 id="contact-heading">Contact me</h2>
  <p class="contact-intro">Have a project, opportunity, or question? Leave me a message.</p>
  <form action={endpoint || undefined} method="POST" data-astro-reload data-contact-form>
    <div class="contact-fields">
      <label>Your name<input name="name" autocomplete="name" required maxlength="100" /></label>
      <label>Your email<input type="email" name="email" autocomplete="email" required maxlength="254" /></label>
    </div>
    <label>Message<textarea name="message" rows="5" required maxlength="5000"></textarea></label>
    <div class="sr-only" aria-hidden="true"><label>Leave this empty<input name="_gotcha" tabindex="-1" autocomplete="off" /></label></div>
    <button type="submit" disabled={!endpoint}>Send message</button>
    <p class="contact-status" role="status" aria-live="polite">{!endpoint}</p>
  </form>
</section>
<style>
  .contact-box {
    max-width: 760px;
    margin: var(--section-gap) auto 0;
    padding: clamp(16px, 4vw, 38px);
    border: 1px solid var(--line);
    border-radius: var(--radius-surface);
    background: var(--surface);
    box-shadow: var(--shadow-inset);
  }

  .contact-intro { margin: var(--space-2) 0 var(--space-5); color: var(--text-muted); }
  .contact-fields { display: grid; grid-template-columns: 1fr 1fr; gap: var(--space-4); }
  label { display: flex; flex-direction: column; gap: var(--space-2); margin-bottom: var(--space-4); }

  input, textarea {
    min-width: 0;
    width: 100%;
    padding: var(--space-3);
    border: 1px solid var(--line);
    border-radius: var(--radius-control);
    background: var(--surface-deep);
    color: var(--text);
    font: inherit;
  }

  textarea { resize: vertical; min-height: 140px; }

  button {
    min-height: 44px;
    padding: var(--space-2) var(--space-5);
    border: 1px solid var(--accent-bright);
    border-radius: var(--radius-control);
    background: var(--accent);
    color: var(--canvas);
    font-weight: 700;
    transition: background-color var(--duration-hover);
  }

  button:hover:not(:disabled) { background: var(--accent-bright); }
  button:disabled { opacity: .65; cursor: default; }
  .contact-status { margin-top: var(--space-3); color: var(--text-muted); min-height: 1.5em; }

  @media (max-width: 599px) { .contact-fields { grid-template-columns: 1fr; gap: 0; } }
</style>
