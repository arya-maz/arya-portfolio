<now-playing class="now-playing" aria-label="Arya’s listening activity">
  <a class="track-link" href="https://www.last.fm/user/aryamaz" target="_blank" rel="noopener noreferrer">
    <span class="artwork-wrap" aria-hidden="true">
      <span class="music-note">♫</span>
      <img class="artwork" alt="" width="52" height="52" hidden />
    </span>
    <span class="track-copy">
      <span class="track-status"><span class="playing-indicator" aria-hidden="true"><span class="playing-dot"></span><span class="equalizer"><span></span><span></span><span></span></span></span><span data-status>Listening activity</span></span>
      <span class="track-title" data-title>Checking Last.fm…</span>
      <span class="track-artist" data-artist>via Last.fm</span>
    </span>
  </a>
  <noscript><style>now-playing { display:none !important; }</style></noscript>
</now-playing>
<script>
  class NowPlaying extends HTMLElement {
    private timer?: ReturnType<typeof setTimeout>;
    private controller?: AbortController;
    private active = false;
    private visibility = () => {
      if (document.hidden) { clearTimeout(this.timer); this.controller?.abort(); }
      else if (!this.active) void this.refresh();
    };
    connectedCallback() {
      document.addEventListener('visibilitychange', this.visibility);
      void this.refresh();
    }
    disconnectedCallback() {
      clearTimeout(this.timer);
      this.controller?.abort();
      document.removeEventListener('visibilitychange', this.visibility);
    }
    private async refresh() {
      if (this.active || document.hidden || !this.isConnected) return;
      this.active = true;
      this.controller = new AbortController();
      const timeout = setTimeout(() => this.controller?.abort(), 10000);
      try {
        const response = await fetch('/api/now-playing', { signal: this.controller.signal });
        if (!response.ok) throw new Error('Unavailable');
        const track = await response.json();
        if (!['playing', 'recent', 'empty'].includes(track.status)) throw new Error('Unavailable');
        const playing = track.status === 'playing';
        const empty = track.status === 'empty';
        this.dataset.playing = String(playing);
        this.querySelector('[data-status]')!.textContent = playing ? 'Now playing' : empty ? 'Listening activity' : 'Last played';
        this.querySelector('[data-title]')!.textContent = empty ? 'No recent tracks' : track.title;
        this.querySelector('[data-artist]')!.textContent = empty ? 'via Last.fm' : `${track.artist} · Last.fm`;
        const link = this.querySelector<HTMLAnchorElement>('.track-link')!;
        link.href = 'https://www.last.fm/user/aryamaz';
        link.title = empty ? 'View Arya on Last.fm' : `${track.title} — ${track.artist}${track.album ? ` · ${track.album}` : ''}`;
        const art = this.querySelector<HTMLImageElement>('.artwork')!;
        const artwork = this.safeUrl(track.artwork);
        art.hidden = !artwork;
        if (artwork && art.getAttribute('src') !== artwork) {
          art.onerror = () => { art.hidden = true; };
          art.src = artwork;
        } else if (!artwork) art.removeAttribute('src');
      } catch {
        // Do not leave a stale song labelled as currently playing after a failure.
        this.dataset.playing = 'false';
        this.querySelector('[data-status]')!.textContent = 'Listening activity';
        this.querySelector('[data-title]')!.textContent = 'Music updates unavailable';
        this.querySelector('[data-artist]')!.textContent = 'View on Last.fm';
        this.querySelector<HTMLAnchorElement>('.track-link')!.href = 'https://www.last.fm/user/aryamaz';
        this.querySelector<HTMLImageElement>('.artwork')!.hidden = true;
      } finally {
        clearTimeout(timeout);
        this.active = false;
        if (this.isConnected && !document.hidden) this.timer = setTimeout(() => void this.refresh(), 30000);
      }
    }
    private safeUrl(value: unknown) {
      try { const url = new URL(String(value)); return url.protocol === 'https:' ? url.href : null; }
      catch { return null; }
    }
  }
  if (!customElements.get('now-playing')) customElements.define('now-playing', NowPlaying);
</script>
<style>
  .now-playing { display:block; width:320px; max-width:100%; flex-shrink:1; }
  .track-link { display:flex; align-items:center; gap:12px; padding:12px 14px; border:1px solid rgb(23 54 75 / 16%); border-radius:12px; background:rgb(250 247 239 / 38%); color:var(--heading); text-decoration:none; }
  .track-link:hover { background:rgb(250 247 239 / 60%); }
  .artwork-wrap { position:relative; display:grid; place-items:center; width:52px; height:52px; flex:none; overflow:hidden; border-radius:6px; background:rgb(23 54 75 / 10%); }
  .music-note { font-size:26px; }
  .artwork { position:absolute; inset:0; width:100%; height:100%; object-fit:cover; }
  .artwork[hidden] { display:none; }
  .track-copy { display:flex; flex-direction:column; gap:3px; min-width:0; }
  .track-status { display:flex; align-items:center; gap:6px; font-size:10px; line-height:1.4; font-weight:600; letter-spacing:.08em; text-transform:uppercase; }
  .playing-dot { width:6px; height:6px; border-radius:50%; background:#7c8790; flex:none; }
  .playing-indicator { display:flex; align-items:center; justify-content:center; width:13px; height:14px; flex:none; }
  .equalizer { display:none; align-items:flex-end; justify-content:center; gap:2px; height:12px; }
  .equalizer > span { display:block; width:3px; height:12px; border-radius:1px; background:#28734f; transform-origin:center bottom; }
  [data-playing='true'] .playing-dot { display:none; }
  [data-playing='true'] .equalizer { display:flex; }
  [data-playing='true'] .equalizer > span { animation:playing-bars .9s ease-in-out infinite alternate; }
  [data-playing='true'] .equalizer > span:nth-child(2) { animation-duration:.7s; animation-delay:-.4s; }
  [data-playing='true'] .equalizer > span:nth-child(3) { animation-duration:1.1s; animation-delay:-.7s; }
  @keyframes playing-bars {
    0% { transform:scaleY(.25); }
    35% { transform:scaleY(.75); }
    65% { transform:scaleY(.4); }
    100% { transform:scaleY(1); }
  }
  @media (prefers-reduced-motion:reduce) {
    [data-playing='true'] .equalizer > span { animation:none; transform:scaleY(.5); }
    [data-playing='true'] .equalizer > span:nth-child(2) { transform:scaleY(1); }
    [data-playing='true'] .equalizer > span:nth-child(3) { transform:scaleY(.7); }
  }
  .track-title { font-size:14px; font-weight:600; line-height:1.4; }
  .track-artist { font-size:12px; line-height:1.4; opacity:.8; }
  .track-title,.track-artist { overflow:hidden; text-overflow:ellipsis; white-space:nowrap; }
  @media (max-width:599px) { .now-playing { display:none; } }
</style>
