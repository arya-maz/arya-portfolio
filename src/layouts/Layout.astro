---
import '../styles/global.css';
import Header from '../components/Header.astro';
interface Props { title: string; page: string }
const { title, page } = Astro.props;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content="Arya Mazandarani’s portfolio — projects, experience, hobbies, and ways to connect." />
    <title>{title} | Arya Mazandarani</title>
    <link rel="icon" href="/favicon.svg?v=am-1" type="image/svg+xml" />
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <div class:list={['site-shell', `page-${page.toLowerCase()}`]}>
      <Header active={page} />
      <main id="main" class="folder"><slot /></main>
      <div class="bottom-border" aria-hidden="true"></div>
    </div>
  </body>
</html>
