---
import { ClientRouter } from 'astro:transitions';
import '../styles/global.css';
import Header, { pages } from '../components/Header.astro';

interface Props { title: string; page: typeof pages[number] }
const { title, page } = Astro.props;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#0c1016" />
    <meta name="description" content="Arya Mazandarani’s portfolio — projects, experience, hobbies, and ways to connect." />
    <title>{title} | Arya Mazandarani</title>
    <link rel="icon" href="/favicon.svg?v=am-1" type="image/svg+xml" />
    <ClientRouter fallback="swap" />
  </head>
  <body>
    <a class="skip-link" href="#main" data-astro-reload>Skip to content</a>
    <div class:list={['site-shell', `page-${page.toLowerCase()}`]} data-folder-index={pages.indexOf(page)}>
      <Header active={page} />
      <main id="main" class="folder" tabindex="-1">
        <div class="folder-light" aria-hidden="true"></div>
        <div class="folder-content"><slot /></div>
      </main>
    </div>
    <script>
      import '../workspace';
    </script>
  </body>
</html>
